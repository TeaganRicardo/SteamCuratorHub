<Window x:Class="SteamCuratorHub.App.QuickCreateTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamCuratorHub.Presentation.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title=""
        Width="920"
        Height="640"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="QuickGameList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="QuickGameItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="166"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Background="{DynamicResource Brush.AppBackground}"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <TextBlock x:Name="WindowHeading"
                               Margin="18,0,48,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <Button HorizontalAlignment="Right"
                            Width="44"
                            Height="37"
                            Padding="0"
                            Style="{DynamicResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click">
                        <TextBlock Text="&#x00D7;" FontSize="18"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SearchLabel"
                                   Style="{DynamicResource MutedText}"
                                   Margin="1,0,0,7"/>
                        <TextBox x:Name="SearchBox"
                                 Height="42"
                                 Style="{DynamicResource InputTextBox}"
                                 Padding="12,9"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,17,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GamesHeading"
                               VerticalAlignment="Center"
                               Style="{DynamicResource SectionTitle}"
                               FontSize="18"/>
                    <Border Grid.Column="1"
                            MinWidth="52"
                            Padding="10,5"
                            Background="{DynamicResource Brush.PrimarySoft}"
                            CornerRadius="14">
                        <TextBlock x:Name="ResultCountLabel"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox x:Name="GamesList"
                             Style="{StaticResource QuickGameList}"
                             ItemContainerStyle="{StaticResource QuickGameItem}"
                             SelectionChanged="GamesList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="88"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                            CornerRadius="9,9,0,0"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Game.HeaderImageUrl}"
                                               Tag="{Binding Game.IconImageUrl}"
                                               Stretch="UniformToFill"
                                               SnapsToDevicePixels="True"
                                               Loaded="GameImage_Loaded"
                                               ImageFailed="GameImage_ImageFailed"/>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="10,8,10,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding LastPlayedLabel}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,3,0,0"
                                                   Text="{Binding RecentPlaytimeLabel}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <Border Width="38"
                                Height="38"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                CornerRadius="19">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="18"
                                       Text="⌕"/>
                        </Border>
                        <TextBlock x:Name="EmptyResultsLabel"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="12"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationLabel"
                           Grid.Row="3"
                           Margin="1,8,0,0"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Padding="14"
                        Style="{DynamicResource CardBorderCompact}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TaskDetailsHeading"
                                   Style="{DynamicResource SectionTitle}"
                                   FontSize="14"/>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="184"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="SelectedGameLabel"
                                           Style="{DynamicResource MutedText}"
                                           Margin="1,0,0,7"/>
                                <Border Height="42"
                                        Padding="10,0"
                                        Background="{DynamicResource Brush.SurfaceElevated}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="SelectedGameSummary"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="TargetHoursLabel"
                                           Style="{DynamicResource MutedText}"
                                           Margin="1,0,0,7"/>
                                <TextBox x:Name="TargetHoursBox"
                                         Height="42"
                                         Text="4"
                                         Style="{DynamicResource InputTextBox}"
                                         Padding="12,9"
                                         VerticalContentAlignment="Center"
                                         TextChanged="Input_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="DueDateLabel"
                                           Style="{DynamicResource MutedText}"
                                           Margin="1,0,0,7"/>
                                <controls:ModernDatePicker x:Name="DueDatePicker"
                                                           Height="42"
                                                           CultureName="en-US"/>
                            </StackPanel>

                            <Button x:Name="CancelButton"
                                    Grid.Column="6"
                                    Height="42"
                                    MinHeight="42"
                                    VerticalAlignment="Bottom"
                                    Style="{DynamicResource GhostButton}"
                                    IsCancel="True"
                                    Padding="15,9"
                                    Click="Cancel_Click"/>
                            <Button x:Name="CreateButton"
                                    Grid.Column="8"
                                    Height="42"
                                    MinHeight="42"
                                    VerticalAlignment="Bottom"
                                    Style="{DynamicResource PrimaryButton}"
                                    IsDefault="True"
                                    Padding="18,9"
                                    Click="Create_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
