<Window x:Class="SteamCuratorHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamCuratorHub.Presentation.Converters"
        xmlns:views="clr-namespace:SteamCuratorHub.Presentation.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title=""
        Width="1420"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:LocalizedTextConverter x:Key="Loc"/>
        <local:LocalizedGameNameConverter x:Key="GameName"/>
        <local:LocalizedStatusConverter x:Key="Status"/>
        <local:LocalizedCuratorCopyStatusConverter x:Key="CopyStatus"/>
        <local:ModernSectionVisibilityConverter x:Key="Section"/>

        <Style x:Key="NavigationList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator"
                                        Width="3"
                                        Height="18"
                                        Background="Transparent"
                                        CornerRadius="2"
                                        VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTaskButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SidebarAddTaskButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TaskActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="DangerTaskActionButton" TargetType="Button" BasedOn="{StaticResource TaskActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="46"
                            Height="35"
                            Padding="0"
                            Style="{StaticResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeWindow_Click"
                            ToolTip="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Minimize}">
                        <TextBlock Text="—" FontSize="13"/>
                    </Button>
                    <Button Width="46"
                            Height="35"
                            Padding="0"
                            Style="{StaticResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="ToggleMaximizeWindow_Click"
                            ToolTip="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Maximize}">
                        <TextBlock Text="□" FontSize="13"/>
                    </Button>
                    <Button Width="46"
                            Height="35"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindow_Click"
                            ToolTip="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Close}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="#C94F55"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="×" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         Style="{StaticResource NavigationList}"
                         ItemContainerStyle="{StaticResource NavigationItem}"
                         ItemsSource="{Binding Navigation}"
                         SelectedValuePath="Key"
                         SelectedValue="{Binding SelectedSection, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="4,24,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource EyebrowText}"
                               Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=ActiveTasks}"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource SidebarAddTaskButton}"
                                Click="QuickCreateTask_Click"
                                IsEnabled="{Binding CanOpenQuickCreate}"
                                ToolTip="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=CreateTask}">
                            <TextBlock Text="+"
                                       Margin="0,-2,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                CornerRadius="8"
                                Padding="7,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveTasks.Count}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarTaskButton}"
                                        Click="SelectTask_Click"
                                        Tag="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="TaskContextMenu_Opened"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Name="SetCurrentTaskMenuItem"
                                                      Tag="{Binding}"
                                                      Click="SetCurrentTask_Click"/>
                                            <Separator/>
                                            <MenuItem Name="OpenPlaythroughMenuItem"
                                                      Tag="{Binding}"
                                                      Click="OpenTaskPlaythrough_Click"/>
                                            <MenuItem Name="OpenEditorMenuItem"
                                                      Tag="{Binding}"
                                                      Click="OpenTaskEditor_Click"/>
                                            <MenuItem Name="EditTaskMenuItem"
                                                      Tag="{Binding}"
                                                      Click="EditTask_Click"/>
                                            <Separator/>
                                            <MenuItem Name="DeleteTaskMenuItem"
                                                      Tag="{Binding}"
                                                      Foreground="{DynamicResource Brush.Danger}"
                                                      Click="DeleteTask_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Grid Height="82">
                                            <Image Source="{Binding Game.HeaderImageUrl}"
                                                   Stretch="UniformToFill"
                                                   Opacity="0.42"/>
                                            <Border Background="#B8121B26"/>
                                            <Grid Margin="12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Top">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource GameName}">
                                                            <Binding Path="Game"/>
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Value="{Binding PlayedHours}"
                                                                 Maximum="{Binding TargetHours}"
                                                                 Height="4"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PlayedHours, StringFormat={}{0:0.0} h}"
                                                               Foreground="{DynamicResource Brush.Primary}"
                                                               FontSize="10"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="Settings"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,12,0,0"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True"
                                Background="{DynamicResource Brush.SurfaceElevated}">
                            <Image Source="{Binding SteamAvatarUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SteamAccountStatusLabel}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SteamAccountDetailsLabel}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.AppBackground}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSectionLabel}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding CurrentGameName}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="Playthrough"
                                Content="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Playthrough}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="Editor"
                                Content="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Editor}"
                                Margin="0,0,12,0"/>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="13,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentTaskStatusLabel}"
                                           Foreground="{DynamicResource Brush.Success}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Width="1" Height="18"
                                        Background="{DynamicResource Brush.Border}"
                                        Margin="12,0"/>
                                <TextBlock Text="{Binding CurrentTaskHours}"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,28">
                <ScrollViewer Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=Dashboard}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=ReviewWorkspace}"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=ReviewWorkspaceHint}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,7,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="Inventory"
                                        Content="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Inventory}"
                                        VerticalAlignment="Center"
                                        Margin="22,0,0,0"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=ActiveTasks}"
                                               Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="{Binding ActiveTasks.Count}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=DueThisWeek}"
                                               Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="{Binding DueThisWeekCount}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=HoursThisWeek}"
                                               Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="{Binding TotalPlayedHours, StringFormat={}{0:0.0} h}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=ActiveTasks}"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveTasks.Count}"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ActiveTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderCompact}"
                                            Margin="0,0,0,9"
                                            Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Click="OpenTaskPlaythrough_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="2"
                                                    HorizontalContentAlignment="Stretch">
                                                <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="166"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Height="54" CornerRadius="7" ClipToBounds="True"
                                                        Background="{DynamicResource Brush.SurfaceElevated}">
                                                    <Image Source="{Binding Game.HeaderImageUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource GameName}">
                                                                <Binding Path="Game"/>
                                                                <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Success}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource Status}">
                                                                    <Binding Path="Status"/>
                                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Margin="8,0,0,0"
                                                                   Text="●"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource Brush.Primary}"
                                                                   ToolTip="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Loc}, ConverterParameter=CurrentTask}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="22,0,12,0" VerticalAlignment="Center">
                                                    <Grid Margin="0,0,0,7">
                                                        <TextBlock Text="{Binding PlayedHours, StringFormat={}{0:0.0} h}"
                                                                   Foreground="{DynamicResource Brush.Primary}"
                                                                   FontSize="11"/>
                                                        <TextBlock Text="{Binding TargetHours, StringFormat={}{0:0.0} h}"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding PlayedHours}" Maximum="{Binding TargetHours}"/>
                                                </StackPanel>
                                                </Grid>
                                            </Button>

                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource TaskActionButton}"
                                                        Tag="{Binding}"
                                                        Content="&#xE768;"
                                                        Click="OpenTaskPlaythrough_Click"
                                                        ToolTip="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Loc}, ConverterParameter=OpenPlaythrough}"/>
                                                <Button Style="{StaticResource TaskActionButton}"
                                                        Tag="{Binding}"
                                                        Content="&#xE70F;"
                                                        Click="OpenTaskEditor_Click"
                                                        ToolTip="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Loc}, ConverterParameter=OpenEditor}"/>
                                                <Button Tag="{Binding}"
                                                        Content="&#xE718;"
                                                        Click="SetCurrentTask_Click"
                                                        ToolTip="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Loc}, ConverterParameter=SetCurrentTask}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource TaskActionButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Style="{StaticResource TaskActionButton}"
                                                        Tag="{Binding}"
                                                        Content="&#xE713;"
                                                        Click="EditTask_Click"
                                                        ToolTip="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Loc}, ConverterParameter=TaskSettings}"/>
                                                <Button Style="{StaticResource DangerTaskActionButton}"
                                                        Tag="{Binding}"
                                                        Content="&#xE74D;"
                                                        Click="DeleteTask_Click"
                                                        ToolTip="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Loc}, ConverterParameter=DeleteTask}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <views:InventoryPanel Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=Inventory}"/>
                <views:PlaythroughPanel Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=Playthrough}"/>
                <views:EditorPanel Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=Editor}"/>

                <ScrollViewer Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=Curator}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=ShortReview}"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding CurrentGameName}" Style="{StaticResource MutedText}" Margin="0,5,0,14"/>
                                    <TextBox Text="{Binding ShortReview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="150"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=SaveDraft}"
                                                Command="{Binding SaveShortDraftCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=PublishRecommendation}"
                                                Click="OpenCuratorReview_Click"
                                                Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=CuratorCopies}"
                                                   Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentCuratorCopies.Count}"
                                                   Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CurrentCuratorCopies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CardBorderCompact}" Margin="0,0,0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource CopyStatus}">
                                                                        <Binding Path="Status"/>
                                                                        <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Click="OpenCuratorConnect_Click"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Margin="12,0,0,0">
                                                            <Button.Content>
                                                                <MultiBinding Converter="{StaticResource CopyStatus}" ConverterParameter="action">
                                                                    <Binding Path="Status"/>
                                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </Button.Content>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <views:SteamSessionPanel x:Name="SteamSessionHost"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=History}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="2,0,2,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Publications}"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HistoryItems.Count}"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderCompact}" Margin="0,0,0,8" Padding="16,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" Background="{DynamicResource Brush.Primary}" CornerRadius="2"/>
                                            <StackPanel Grid.Column="1" Margin="13,0">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TimestampLabel}" Style="{StaticResource MutedText}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding SelectedSection, Converter={StaticResource Section}, ConverterParameter=Settings}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=Language}"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Languages}"
                                          SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True"
                                        Background="{DynamicResource Brush.SurfaceElevated}">
                                    <Image Source="{Binding SteamAvatarUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SteamAccountStatusLabel}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding SteamAccountDetailsLabel}" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SteamLoadError}" Foreground="{DynamicResource Brush.Danger}"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="28"
                                        Background="{DynamicResource Brush.PrimarySoft}">
                                    <TextBlock Text="AI"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               FontSize="15"
                                               FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Language, Converter={StaticResource Loc}, ConverterParameter=AIService}"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding AiServiceDetailsLabel}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding AiConfigurationHint}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAiConfigured}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AiDataNotice}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,12,0"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Padding="12,7"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.SurfaceElevated}"
                                        CornerRadius="16">
                                    <TextBlock Text="{Binding AiServiceStatusLabel}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
