<Window x:Class="SteamCuratorHub.App.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="460"
        MinHeight="220"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Background="{DynamicResource Brush.AppBackground}"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <TextBlock x:Name="TitleLabel"
                               Margin="16,0,48,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseButton"
                            Width="38"
                            Height="37"
                            HorizontalAlignment="Right"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0,10,0,0">
                                    <TextBlock Text="×"
                                               FontSize="17"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="#C94F55"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar"
                        Width="4"
                        Background="{DynamicResource Brush.Primary}"
                        CornerRadius="2"/>
                <Grid Grid.Column="1" Margin="17,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageLabel"
                                   Style="{DynamicResource BodyText}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="13"
                                   LineHeight="21"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,22,0,0">
                        <Button x:Name="TertiaryButton"
                                Style="{DynamicResource GhostButton}"
                                Click="Tertiary_Click"
                                Visibility="Collapsed"
                                Margin="0,0,8,0"
                                MinWidth="82"/>
                        <Button x:Name="SecondaryButton"
                                Style="{DynamicResource SecondaryButton}"
                                Click="Secondary_Click"
                                Margin="0,0,8,0"
                                MinWidth="82"/>
                        <Button x:Name="PrimaryActionButton"
                                Style="{DynamicResource PrimaryButton}"
                                Click="Primary_Click"
                                IsDefault="True"
                                MinWidth="82"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
