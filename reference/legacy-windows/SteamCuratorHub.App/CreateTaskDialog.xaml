<Window x:Class="SteamCuratorHub.App.CreateTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SteamCuratorHub.Presentation.Controls"
        Title="Create review task"
        Width="468"
        Height="370"
        MinWidth="468"
        MinHeight="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.AppBackground}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="HeaderLabel"
                               Margin="20,0,52,0"
                               VerticalAlignment="Center"
                               Text="Create review task"
                               Style="{DynamicResource SectionTitle}"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseButton"
                            Width="32"
                            Height="32"
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="×"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="20"
                            FontWeight="Normal"
                            IsCancel="True"
                            Style="{DynamicResource GhostButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,18">
                    <TextBlock x:Name="GameLabel"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TargetHoursLabel"
                                   Text="Target hours"
                                   Style="{DynamicResource MutedText}"
                                   Margin="1,0,0,7"/>
                        <TextBox x:Name="TargetHoursBox"
                                 Height="42"
                                 Text="4"
                                 Style="{DynamicResource InputTextBox}"
                                 Padding="11,8"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="DueDateLabel"
                                   Text="Due date"
                                   Style="{DynamicResource MutedText}"
                                   Margin="1,0,0,7"/>
                        <controls:ModernDatePicker x:Name="DueDatePicker"
                                                   Height="42"
                                                   HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Height="1"
                        Margin="0,18,0,14"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Brush.Border}"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Style="{DynamicResource GhostButton}"
                            Padding="15,9"
                            Margin="0,0,8,0"/>
                    <Button x:Name="CreateButton"
                            Content="Create task"
                            Click="Create_Click"
                            IsDefault="True"
                            Style="{DynamicResource PrimaryButton}"
                            Padding="17,9"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
