<UserControl x:Class="SteamCuratorHub.Presentation.Views.PlaythroughPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SteamCuratorHub.Presentation.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <local:LocalizedTextConverter x:Key="Loc"/>
        <local:LocalizedGameNameConverter x:Key="GameName"/>
        <local:LocalizedStatusConverter x:Key="Status"/>
        <local:LocalizedAchievementTextConverter x:Key="AchievementText"/>
        <local:LocalizedAchievementStateConverter x:Key="AchievementState"/>

        <Style x:Key="TaskSelectorButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AchievementStateDot" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AchievementStateGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x25CB;"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Text" Value="&#x2713;"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*" MinWidth="450"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,20,0"
                Padding="18"
                Style="{DynamicResource CardBorder}"
                Background="{DynamicResource Brush.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Style="{DynamicResource EyebrowText}"
                                   Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=ActiveTasks}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Style="{DynamicResource SectionTitle}"
                                   FontSize="20"
                                   Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=ChooseTask}"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right"
                            MinWidth="38"
                            Padding="9,5"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Brush.PrimarySoft}"
                            CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActiveTasks.Count}"/>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1"
                        Margin="0,16,0,14"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Click="SelectTask_Click"
                                        Style="{StaticResource TaskSelectorButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="3"
                                                Margin="0,2,0,2"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource Brush.Primary}"
                                                CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="38">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource GameName}">
                                                        <Binding Path="Game"/>
                                                        <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Brush.PrimarySoft}"
                                                        CornerRadius="10">
                                                    <TextBlock Foreground="{DynamicResource Brush.Primary}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource Status}">
                                                                <Binding Path="Status"/>
                                                                <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{DynamicResource MutedText}"
                                                           FontSize="10"
                                                           Text="{Binding PlayedHours, StringFormat={}{0:0.0} h}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24"
                    Style="{DynamicResource CardBorder}"
                    Background="{DynamicResource Brush.Surface}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{DynamicResource EyebrowText}"
                                       Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=Simulation}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource SectionTitle}"
                                       FontSize="23"
                                       TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource GameName}">
                                        <Binding Path="SelectedTask.Game"/>
                                        <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="12,6"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7"
                                        Height="7"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Primary}"
                                        CornerRadius="4"/>
                                <TextBlock Foreground="{DynamicResource Brush.Primary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="{Binding CurrentPlaythroughStatusLabel}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{DynamicResource EyebrowText}"
                                       Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=TargetHours}"/>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentTaskHours}"/>
                            <ProgressBar Margin="0,13,28,0"
                                         Height="7"
                                         Maximum="1"
                                         Value="{Binding CurrentTaskProgress, Mode=OneWay}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource Brush.Border}"/>

                        <StackPanel Grid.Column="2" Margin="24,0,0,0">
                            <TextBlock Style="{DynamicResource EyebrowText}"
                                       Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=DueDate}"/>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding DueLabel}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,9,0"
                                Padding="18,9"
                                Style="{DynamicResource PrimaryButton}"
                                Content="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=StartRun}"
                                Command="{Binding StartRunCommand}"/>
                        <Button Margin="0,0,9,0"
                                Padding="18,9"
                                Style="{DynamicResource SecondaryButton}"
                                Content="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=Pause}"
                                Command="{Binding PauseRunCommand}"/>
                        <Button Padding="18,9"
                                Style="{DynamicResource GhostButton}"
                                Content="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=MarkComplete}"
                                Command="{Binding MarkCompleteCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="0"
                    Style="{DynamicResource CardBorder}"
                    Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,22,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource EyebrowText}"
                                       Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=Achievements}"/>
                            <TextBlock Margin="0,4,0,0"
                                       Style="{DynamicResource SectionTitle}"
                                       FontSize="18"
                                       Text="{Binding DataContext.Language, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Loc}, ConverterParameter=Achievements}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       FontSize="11"
                                       Text="{Binding AchievementsError}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAchievementsError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1"
                                MinWidth="38"
                                Padding="9,5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedTask.Achievements.Count, StringFormat={}{0}}"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedTask.Achievements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="22,13"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource AchievementStateDot}">
                                                <TextBlock Style="{StaticResource AchievementStateGlyph}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="4,0,20,0" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource AchievementText}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Margin="0,4,0,0"
                                                           Style="{DynamicResource MutedText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="34">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource AchievementText}" ConverterParameter="description">
                                                            <Binding/>
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource Brush.Primary}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource AchievementState}">
                                                            <Binding Path="IsUnlocked"/>
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <ProgressBar Margin="0,8,0,0"
                                                             Height="5"
                                                             Maximum="1"
                                                             Value="{Binding Progress, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
