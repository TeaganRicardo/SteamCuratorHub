<UserControl x:Class="SteamCuratorHub.Presentation.Views.GameStoreDetailsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SteamCuratorHub.Presentation.Converters"
             xmlns:views="clr-namespace:SteamCuratorHub.Presentation.Views"
             MinWidth="360"
             Background="Transparent"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <local:LocalizedTextConverter x:Key="Loc"/>

        <Style x:Key="StoreSectionCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>

        <Style x:Key="StoreMetaChip" TargetType="Border">
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="StoreCompactAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="0"
            Style="{DynamicResource CardBorder}"
            Background="{DynamicResource Brush.Surface}"
            ClipToBounds="True">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <Grid Height="190"
                          Background="{DynamicResource Brush.SurfaceElevated}"
                          ClipToBounds="True">
                        <Image Source="{Binding HeroImageUrl, ElementName=Root}"
                               Stretch="UniformToFill"
                               SnapsToDevicePixels="True"/>
                        <Rectangle VerticalAlignment="Bottom"
                                   Height="92">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Offset="0" Color="#00121B26"/>
                                    <GradientStop Offset="1" Color="#D9121B26"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <ProgressBar Height="3"
                                     VerticalAlignment="Top"
                                     AutomationProperties.Name="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=StoreDetails}"
                                     IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameDetailsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>

                    <StackPanel Margin="18,17,18,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource EyebrowText}"
                                       Text="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=ViewDetails}"/>
                            <Border Grid.Column="1"
                                    Padding="9,4"
                                    CornerRadius="11">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedGameOwned, ElementName=Root}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding OwnedStatusLabel, ElementName=Root}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedGameOwned, ElementName=Root}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   LineHeight="27"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedGameName, ElementName=Root}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Style="{DynamicResource MutedText}"
                                   FontSize="11"
                                   Text="{Binding AppIdLabel, ElementName=Root}"/>

                        <WrapPanel Margin="0,13,0,7">
                            <Border Style="{StaticResource StoreMetaChip}">
                                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                           FontSize="11"
                                           Text="{Binding PlaytimeLabel, ElementName=Root}"/>
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StoreMetaChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReviewSummary, ElementName=Root}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource Brush.Success}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="{Binding ReviewSummary, ElementName=Root}"/>
                            </Border>
                        </WrapPanel>

                        <Border Margin="0,0,0,10"
                                Padding="12,10"
                                Background="{DynamicResource Brush.SurfaceElevated}"
                                BorderBrush="{DynamicResource Brush.Danger}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGameDetailsError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="{Binding GameDetailsError}"
                                           Text="{Binding GameDetailsError}"/>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Command="{Binding RetryGameDetailsCommand}"
                                        Style="{StaticResource StoreCompactAction}"
                                        Content="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=TryAgain}"/>
                            </Grid>
                        </Border>

                        <Button Margin="0,0,0,14"
                                HorizontalAlignment="Stretch"
                                Click="CreateTaskButton_Click"
                                Content="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=CreateTask}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCreateTask, ElementName=Root}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Style="{StaticResource StoreSectionCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource EyebrowText}"
                                               Text="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=StoreDescription}"/>
                                    <Button Grid.Column="1"
                                            Click="TranslateDescription_Click"
                                            IsEnabled="{Binding Research.CanTranslateDescription}"
                                            Style="{StaticResource StoreCompactAction}"
                                            Content="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=Translate}"/>
                                </Grid>

                                <TextBlock Margin="0,10,0,0"
                                           MaxHeight="{Binding DescriptionMaxHeight, ElementName=Root}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           FontSize="12"
                                           LineHeight="20"
                                           Text="{Binding OfficialDescription, ElementName=Root}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"/>

                                <Button Margin="0,6,0,0"
                                        HorizontalAlignment="Right"
                                        Click="DescriptionExpand_Click"
                                        Content="{Binding DescriptionExpandLabel, ElementName=Root}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StoreCompactAction}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDescriptionLong, ElementName=Root}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Margin="0,11,0,0"
                                        Padding="12"
                                        Background="{DynamicResource Brush.PrimarySoft}"
                                        CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Research.HasDescriptionTranslation}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Primary}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=AIGenerated}"/>
                                            <Button Grid.Column="1"
                                                    Click="ToggleDescriptionVersion_Click"
                                                    Style="{StaticResource StoreCompactAction}">
                                                <Button.Content>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=ShowOriginal}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Research.IsShowingOriginalDescription}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=ShowTranslation}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.Content>
                                            </Button>
                                        </Grid>
                                        <TextBlock Margin="0,7,0,0"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   FontSize="12"
                                                   LineHeight="20"
                                                   Text="{Binding Research.DescriptionDisplay}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StoreSectionCard}"
                                Margin="0">
                            <views:ReviewResearchPanel/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Margin="18"
                    Padding="24"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="12"
                           Text="{Binding DataContext.Language, ElementName=Root, Converter={StaticResource Loc}, ConverterParameter=NoGameSelected}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
